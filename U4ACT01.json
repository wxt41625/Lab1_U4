              }
            ],
            "url": "{{baseUrl}}/restconf/data/Cisco-IOS-XE-native:native",
            "description": "Se usa clave deliberadamente incorrecta en lugar de la variable password, para demostrar 401. Captura 14.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "Cisco123",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "16 - GET URI equivocada (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/yang-data+json"
              },
              {
                "key": "Content-Type",
                "value": "application/yang-data+json"
              }
            ],
            "url": "{{baseUrl}}/restconf/data/ietf-interfaces:interfases",
            "description": "Typo intencional: interfases. Esperado: 404. Captura 15."
          },
          "response": []
        },
        {
          "name": "17 - POST JSON mal formado (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/yang-data+json"
              },
              {
                "key": "Content-Type",
                "value": "application/yang-data+json"
              }
            ],
            "url": "{{baseUrl}}/restconf/data/ietf-interfaces:interfaces",
            "description": "JSON truncado a propósito. Esperado: 400 Bad Request. No crear interfaz si por accidente se corrige el JSON. Captura 16.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ietf-interfaces:interface\": {\n    \"name\": \"Loopback8\",\n    \"description\": \"Prueba de JSON inválido por Irvin Misael Mejía Hernández\"\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "18 - POST tipo de contenido no permitido (415) opcional",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/yang-data+json"
              },
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": "{{baseUrl}}/restconf/data/ietf-interfaces:interfaces",
            "description": "Intentar provocar 415 Unsupported Media Type. El servidor puede devolver otro error de 4xx según su implementación. Opcional.",
            "body": {
              "mode": "raw",
              "raw": "Esto no es un documento YANG JSON.",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
